# ═══════════════════════════════════════════════════════════════════════════
# NEURALIS - Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# App Environment: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Sentry (Error Tracking)
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# RevenueCat (In-App Purchases) - Only needed for production
# EXPO_PUBLIC_RC_APPLE_KEY=appl_your_key
# EXPO_PUBLIC_RC_GOOGLE_KEY=goog_your_key
